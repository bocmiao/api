# 基础
PORT=3000
# PUBLIC_URL=https://api.example.com
# TRUST_PROXY=1
# DATA_DIR=./data

# 额度
ANON_DAILY_LIMIT=100
ANON_MINUTE_LIMIT=20
USER_DAILY_LIMIT=10000
USER_MINUTE_LIMIT=120

# 来源网站的日汇总保留天数（1~3660）；请求明细仍按 LOG_RETENTION_DAYS 保留，默认 30 天
# SOURCE_RETENTION_DAYS=365
# 仅列出明确专用于内部测试的已有账号/Key ID；默认空。不是管理员名单，不接受域名/IP/请求头标记。
# 账号配置覆盖该账号后续全部调用；Key 配置只覆盖该 Key，其他 Key/网页登录不受影响。
# STATS_INTERNAL_USER_IDS=
# STATS_INTERNAL_KEY_IDS=

# 账号
REGISTRATION_OPEN=1
# ADMIN_EMAILS=you@example.com

# 邮件推送（可选）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@qq.com
# SMTP_PASS=授权码
# SMTP_FROM=Miao API <you@qq.com>

# 第三方密钥（可选）
# KUAIDI100_KEY=
# KUAIDI100_CUSTOMER=
# DEEPL_API_KEY=
# BAIDU_TRANSLATE_APPID=
# BAIDU_TRANSLATE_KEY=
# YOUDAO_APP_KEY=
# YOUDAO_APP_SECRET=
# QWEATHER_KEY=
# QWEATHER_HOST=
# ITAD_API_KEY=
# COINGECKO_API_KEY=
# 新建企业微信/QQ 机器人渠道的服务端加密密钥：32 字节十六进制，请自行安全生成并妥善备份；丢失后渠道凭据无法解密。
# NOTIFY_ENCRYPTION_KEY=
